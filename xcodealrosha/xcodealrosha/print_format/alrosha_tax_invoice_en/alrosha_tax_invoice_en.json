 "css": "@page {\n  /*margin-top:100px;*/\n  /*margin-bottom:100px*/\n}\ntable{\n    border: 2px solid black;\n}\n.company-info tr:nth(4) td {\n  text-align: left;\n}\ntable{width: 100%;}\n.red > div{\n    padding:4px;\n}\n.item-table{\n    text-align:center;\n}\n.company-info th, .company-info td {\n    padding: 2px !important;\n}\n.item-table th{\n    background-color:#C0262D;\n    color:white;\n    text-align:center;\n    border: 1px solid black;\n}\n\n.colored{    background-color:#C0262D;\n    color:white;\n    text-align:center;}\n.item-table td{\n    border: 1px solid black;\n}",
 "custom_format": 1,
 "default_print_language": "en",
 "disabled": 0,
 "doc_type": "Sales Invoice",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Roboto+Serif:ital,opsz,wght@0,8..144,100..900;1,8..144,100..900&display=swap\" rel=\"stylesheet\">\n<style>\n* {\n    font-family: 'Roboto Serif';\n}\n</style>\n\n\n\n<div class=\"height\">\n    \n    <h1 style=\"border-bottom:2px solid black;text-align: end; font-weight: 900;\">Tax Invoice</h1>\n    <div style=\"display: flex;\n    flex-direction: row;\n    justify-content: space-between;\n        \"> \n        <div  style=\"margin-top: 34px;width:50%;display: flex\n;\n    flex-direction: column;\n    justify-content: start;\n    align-items: start;\"> \n                         <div class=\"red\" style=\"display: flex;\n    flex-direction: row;\">\n                             <div style=\"background-color:#C0262D;width:100px;    text-align: start;border: 1px solid black; color:white;\">Invoice No.</div>\n                             <div style=\"border: 1px solid black; border-left:none; width:150px;    text-align: center;\">{{doc.name or \"\"}}</div>\n                         </div>\n                         <div class=\"red\" style=\"display: flex;\n    flex-direction: row;\">\n                             <div style=\"background-color:#C0262D;width:100px;    text-align: start;border: 1px solid black;border-top:none;border-bottom:none;color:white;\">Date</div>\n                             <div style=\"border: 1px solid black; border-left:none;border-top:none;border-bottom:none; width:150px;    text-align: center;\">{{doc.posting_date or \"\"}}</div> \n                         </div>\n                         <div class=\"red\" style=\"display: flex;\n    flex-direction: row;\">\n                             <div style=\"background-color:#C0262D;width:100px;    text-align: start;border: 1px solid black;color:white;\">Terms(days)</div>\n                             <div style=\"border: 1px solid black; border-left:none; width:150px;    text-align: center;\">{{\"\" }}</div> \n                         </div>\n        </div>\n        <div style=\"width:32%\"> \n        <img style=\"\" src=\"/assets/xcodealrosha/images/a884eac1-8331-4172-b292-0a5391c72c67.jpeg\" >\n        </div>\n    </div>\n    \n        <div style=\"display: flex;\n            flex-direction: row;\n            justify-content: space-between;\n            border-bottom:1px solid black;\n            padding-bottom: 12px;\n                \"> \n            <div  style=\"width:43%;display: flex\n    ;\n                flex-direction: column;\n                justify-content: start;\n                align-items: start; text-align: start;margin-right:50px;\"> \n {% if doc.customer_address %}\n                 {% set address = frappe.get_doc('Address', doc.customer_address) %}\n                  {% endif %}\n            {% if doc.contact_person%}\n                  {% set contact = frappe.get_doc('Contact', doc.contact_person) %}\n                     {% endif %}\n                    <strong style=\"border-bottom:1px solid black;width: 100%;\n                     \">Invoice to:</strong>\n                    <strong>{{doc.customer or \"\"}}</strong>\n                     {% if contact%}\n                    Attn: {{contact.full_name or \"\"}} <br>\n                     {% endif %}\n                     {% if address%}\n                    Tel: {{address.phone or \"\"}}<br>\n                {#  {% set multiline_address = doc.address_display  %}  #}\n                 {# {{ doc.address_display  or \"\"}} #}\n                 {#    {{ multiline_address |replace(\"<br>\", \",\")  or \"\"}}  #}\n                     {{address.address_line1 or \"\"}}<br>\n                      {% endif %}\n                    TRN: {{doc.tax_id or \"\"}}<br>\n                     {% if address%}\n                    P.O. Box: {{address.custom_po_box or \"\"}}<br>\n                    Email: {{address.email_id or \"\"}}\n                      {% endif %}\n            </div>\n            <div style=\"width:50%;display: flex\n    ;\n                flex-direction: column;\n                justify-content: start;\n                align-items: start; text-align: start;\"> \n                    <strong style=\"border-bottom:1px solid black;width: 100%;\n                    \">Notes:</strong>\n                    The invoice has been generated for the following services provided in terms agreed beforehand.<br><br>\n                    <strong style=\"border-bottom:1px solid black;width: 100%;\n                    \">References:</strong>\n                    Purchase Order No (PO): {{doc.custom_purchase_order_no or \"\"}}<br>\n                    \n                    As Per Approved Qoutation No: {{doc.custom_as_per_approved_qoutation_no or \"\"}}\n            </div>\n    </div>\n     <h3 style=\"text-align: start;\">Project Name</h3>\n     <div style=\"text-align: center;\">{{doc.custom_project_name or \"\"  or \"\"}}</div>\n     <h3 style=\"text-align: start;\">Location <span style=\"font-weight: normal !important;font-size: small;\"> {{ doc.custom_project_location or \"\"}}</span> </h3>\n\n</div>\n\n   {% set vat = doc.taxes[0].rate if doc.taxes and doc.taxes[0] else 0 %}\n\n\n   <table class=\"item-table\">\n            <thead>\n                <tr>\n                    <th width=\"15%\" style=\"padding: 2px !important;\">Item No.</th>\n                    <th width=\"35%\" style=\"padding: 2px !important;\">Description</th>\n                    <th width=\"7%\" style=\"padding: 2px !important;\">Qty</th>\n                    <th width=\"5%\" style=\"padding: 2px !important;\">UOM</th>\n                    <th width=\"8%\" style=\"padding: 2px !important;\">Price</th>\n                    <th width=\"10%\" style=\"padding: 2px !important;\">VAT</th>\n                    <th width=\"20%\" style=\"padding: 2px !important;\">Total (Inc VAT)</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                <tr>\n                    <td> {{item.idx or \"\"}}</td>\n                    <td> {{item.description or \"\"}}</td>\n                    <td> {{item.qty or \"\"}}</td>\n                    <td> {{item.uom or \"\"}}</td>\n                    <td> {{item.rate or \"\"}}</td>\n                    <td> {{ \"{:,.2f}\".format(item.amount * (vat / 100))  or \"\"}}</td>\n                    <td> {{ \"{:,.2f}\".format(item.amount + (item.amount * (vat / 100)))  or \"\"}}</td>\n                </tr>\n                 \n                {% endfor %}\n            </tbody>\n        </table>\n        \n                <div style=\"display: flex;\n            flex-direction: row;\n            justify-content: space-between;\n            text-align:start;\n           margin-top:20px;\n                \"> \n                <div style=\"  width:55%; margin-right:5%\">\n                    <div style=\"  background-color:#C0262D; height:20px;\"></div>\n                    <div style=\"  \"> <strong>Total Amount In Words: </strong></div>\n                    <div style=\" border:2px solid black;text-align:center;padding:6px; \">{{doc.in_words or \"\"}}</div>\n                </div>\n                \n                  <div style=\" width:40% \">\n                      <div style=\"  background-color:#C0262D;height:20px; \"></div>\n                      <div style=\" display: flex;\n            flex-direction: row;\n            justify-content: space-between; \">\n            <span>Subtotal: </span>\n            <span>{{doc.net_total or \"\"}} {{\" AED\"}}</span>\n            </div>\n                      <div style=\"   border-bottom:1px solid black;display: flex;\n            flex-direction: row;\n            justify-content: space-between;\"> \n            <span> VAT (5%):</span>\n            <span>{{doc.total_taxes_and_charges or \"\"}}\n            \n            {% if doc.total_taxes_and_charges%}\n            \n            {{\" AED\"}}\n            {% endif %}\n            \n            </span>\n            </div>\n                      <div style=\"  border-bottom:1px solid black; display: flex;\n            flex-direction: row;\n            justify-content: space-between;\">\n                          <span><strong>Total: </strong></span>\n                          <span>{{doc.grand_total or \"\"}}  {{\" AED\"}}</span>\n                          \n                          </div>\n                      <div style=\"  border-bottom:1px solid black;margin-top:1px; \"></div>\n                  </div>\n                \n                </div>\n  \n            \n              <table class=\"item-table company-info\" style=\"margin-top:20px \">\n                <!--<thead>-->\n\n                <!--</thead>-->\n                <tbody>\n                <tr>\n                        <td class=\"colored\" width=\"55%\" colspan=\"2\">Bank Details</td>\n                        <td class=\"colored\" width=\"45%\" colspan=\"2\">Company Details</td>\n    \n                    </tr>\n    \n                    <tr>\n                        <td style=\"text-align: left;\">\n                            <strong> Company Name:</strong>\n                           \n                        </td>\n                        <td colspan=\"3\">\n                            AL Rosha General Maintenance & Cleaning Establishment\n                        </td>\n                    </tr>\n                    <tr>\n                        <td style=\"text-align: left;\">\n                            <strong> Account Name:</strong>\n                           \n                        </td>\n                          <td colspan=\"3\">\n                              AL ROSHA GEN, MAINT & CLEANING EST\n                        </td>                      \n                    </tr>\n                    <tr>\n                        <td style=\"text-align: left;\">\n                            <strong>  Bank Name:</strong>\n                          \n                        </td>\n                        \n                             <td style=\"text-align: left;\">\n                                 ADCB\n                        </td>                   \n                        \n                             <td style=\"text-align: left;\">\n                                 <strong> TRN No.:</strong>\n                                \n                        </td>                   \n                        \n                           <td style=\"text-align: left;\">\n                               104743104200003\n                        </td>                     \n                    </tr>\n                     <tr>\n                        <td style=\"text-align: left;\">\n                            <strong> Acct No.: </strong>\n                            \n                        </td>\n                        \n                             <td style=\"text-align: left;\">\n                                 275104020001\n                        </td>                   \n                        \n                             <td style=\"text-align: left;\">\n                                 <strong>Tel No.: </strong>\n                                 \n                        </td>                   \n                        \n                           <td style=\"text-align: left;\">\n                            +971 2 641 0062\n                        </td>   \n                    </tr>                   \n                    \n                    <tr>\n                        <td style=\"text-align: left;\">\n                            <strong>  IBAN: </strong>\n                           \n                        </td>\n                        \n                             <td style=\"text-align: left;\">\n                                 AE390030000275104020001\n                        </td>                   \n                        \n                             <td style=\"text-align: left;\">\n                                 <strong>   Email: </strong>\n                               \n                        </td>                   \n                        \n                           <td style=\"text-align: left;\">\n                               info@alroshagroup.com\n                        </td>  \n                    </tr>                    \n                    \n                    <tr>\n                        <td style=\"text-align: left;\">\n                            <strong> Swift Code:</strong>\n                           \n                        </td>\n                        \n                             <td style=\"text-align: left;\">\n                                  ADCBAEAA\n                        </td>                   \n                        \n                             <td style=\"text-align: left;\">\n                                 <strong> P.O. Box: </strong>\n                                 \n                        </td>                   \n                        \n                           <td style=\"text-align: left;\">\n                               7320\n                        </td>  \n                    </tr>                    \n                    \n                    \n                </tbody>\n            </table>\n\n   </div>\n        <div style=\"margin-top: 20px; display: flex; justify-content: space-between;\">\n            <div>Receiver's Sign & Stamp <br>  </div>\n            <div>AL Rosha Sign & Stamp <br> </div>\n        </div>\n\n\n",
