 "html": "<div style=\"direction: rtl;\">\n   <table class=\"header-table\" >\n    <tbody>\n        {% if doc.customer_address %}\n      {% set address = frappe.get_doc('Address', doc.customer_address) %}\n                   {% endif %}\n            {% if doc.contact_person%}\n       {% set contact = frappe.get_doc('Contact', doc.contact_person) %}\n         {% endif %}\n        <tr> <td > \n        <span>  \u0631\u0642\u0645 \u0639.\u0633:</span>\n          <span> \n{{doc.name or \"\"}}\n          </span>\n       </td> </tr>\n        <tr> <td> \n        \n        <span>\n             \u0627\u0644\u0649:  \n        </span>\n         <span>\n\n         </span>\n{{doc.party_name or \"\"}}\n        </td> </tr>\n          {% if contact%}\n        <tr> <td> \n         <span>\n             \u0627\u0644\u0634\u062e\u0635:\n         </span>\n          <span>\n              \n{{contact.full_name or \"\"}}\n          </span>\n        \n        \n        </td> </tr>\n        {% endif %}\n         {% if address%}\n        <tr> <td> \n        <span>\n                    \u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641: \n        </span>\n          <span >\n{{address.phone or \"\"}}          </span>\n          </span>\n        </td> </tr>\n            {% endif %}\n\n        <tr> <td> \n        <span>\n            \u0627\u0644\u062a\u0627\u0631\u064a\u062e:\n        </span>\n          <span>\n{{doc.transaction_date or \"\"}}            </span>\n        </td> </tr>\n    </tbody>\n</table>\n\n<div style=\"text-align:center; font-size:16px;margin-bottom:8px;\">\n    <b>\n        \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631\n    </b>\n</div>\n<div style=\"text-align:center;  width:auto;\">\n    <div style=\"display:inline-block;border-bottom:1px solid black;\">\n            <b>\n        \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\n    </b>\n    </div>\n\n</div>\n\n<div style=\"text-align:center;border-bottom:2px solid black;\">\n        \n{{doc.custom_project_name or \"\"  }}  </div>\n\n\n<div style=\"text-align:right;\">\n    <b>\n\u0627\u0644\u0645\u0648\u0642\u0639:\n</b>\n</div>\n\n\n<div style=\"text-align:center;\">\n{{doc.custom_project_location or \"\" }} </div>\n\n\n</div>\n\n\n\n {% set vat = doc.taxes[0].rate if doc.taxes and doc.taxes[0] else 0 %}\n\n\n   <table class=\"item-table\" dir=\"rtl\">\n            <thead>\n                <tr>\n                    <th width=\"15%\">\n                        \u0627\u0644\u0631\u0642\u0645\n                    </th>\n                    <th width=\"40%\">\n                        \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644\n                    </th>\n                    <th width=\"7%\">\n                    \u0627\u0644\u0648\u062d\u062f\u0629    \n                    </th>\n                    <th width=\"8%\">\n                        \u0627\u0644\u0643\u0645\u064a\u0629\n                    </th>\n                    <th width=\"14%\">\n                        \u0633\u0639\u0631 \u0627\u0644\u0648\u062d\u062f\u0629\n                    </th>\n                    <th width=\"16%\">\n                        \u0627\u0644\u0633\u0639\u0631\n                    </th>\n                </tr>\n            </thead>\n            <tbody>\n                {% for item in doc.items %}\n                <tr>\n                    <td> {{item.idx or \"\"}}</td>\n                    <td> {{item.description or \"\"}}</td>\n                    <td> {{item.uom or \"\"}}</td>\n                    <td> {{item.qty or \"\"}}</td>\n                    \n                    <td> {{\"{:,.2f}\".format(item.rate) or \"\"}}</td>\n                    \n                    <td> {{\"{:,.2f}\".format(item.amount)  or \"\"}}</td>\n                </tr>\n                 \n                {% endfor %}\n                \n                <tr style=\"background-color:#fba8b8;\">\n                    <td colspan=\"5\">\n                      \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u063a\u064a\u0631 \u0634\u0627\u0645\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 \u0628\u0627\u0644\u062f\u0631\u0647\u0645 \u0627\u0644\u0627\u0645\u0627\u0631\u0627\u062a\u064a\n                    </td>\n                    <td >\n                        \n                        {{ \"{:,.2f}\".format(doc.net_total) or \"\"}}\n                    </td>\n                </tr>\n                \n                <tr style=\"background-color:#fba8b8;\">\n                    <td colspan=\"5\">\n                        \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 5% \u0628\u0627\u0644\u062f\u0631\u0647\u0645 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\n                     </td>\n                    <td >\n                        \n                       {{ \"{:,.2f}\".format(doc.total_taxes_and_charges)  or \"\"}}\n                    </td>\n                </tr>\n                \n                <tr style=\"background-color:#fba8b8;\">\n                    <td colspan=\"5\">\n                        \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a \u0634\u0627\u0645\u0644 \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 \u0628\u0627\u0644\u062f\u0631\u0647\u0645 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\n                     </td>\n                    <td >\n                        \n                       {{ \"{:,.2f}\".format(doc.grand_total)  or \"\"}}\n                    </td>\n                </tr>\n            </tbody>\n        </table>\n        \n        \n        \n<div style=\"direction: rtl;\"> \n<div style=\"font-size:16px;margin-top:8px;\">\n<b>\n        \u0627\u0644\u0633\u0639\u0631\n        \n</b>\n</div>\n\n<div style=\"\">\n\n\u0633\u0639\u0631\u0646\u0627 \u0644\u0647\u0630\u0627 \u0627\u0644\u0639\u0645\u0644 \u0634\u0627\u0645\u0644\u0627\u064b \u0636\u0631\u064a\u0628\u0629 \u0627\u0644\u0642\u064a\u0645\u0629 \u0627\u0644\u0645\u0636\u0627\u0641\u0629 \u0633\u064a\u0643\u0648\u0646    {{ \"{:,.2f}\".format(doc.grand_total)  or \"\"}} \u062f\u0631\u0647\u0645\u0627\u064b \u0625\u0645\u0627\u0631\u0627\u062a\u064a\u0627\u064b.\n\n</div>\n<div style=\"font-size:16px;margin-top:8px;\">\n<b>\n\u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629        \n</b>\n</div>\n\n<div style=\"\">\n\u0635\u0644\u0627\u062d\u064a\u0629 \u0647\u0630\u0627 \u0627\u0644\u0639\u0631\u0636 \u0647\u064a \u0644\u0645\u062f\u0629 30 \u064a\u0648\u0645\u0627\u064b \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0637\u0628\u0627\u0639\u0629.\n\n</div>\n\n<div style=\"font-size:16px;margin-top:8px;\">\n<b>\n\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645\n</b>\n</div>\n\n<div style=\"\">\n\u0623\u064a \u0643\u0645\u064a\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0641\u0648\u0642 \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u0627\u0644\u0645\u0630\u0643\u0648\u0631\u0629 \u0633\u062a\u0624\u062f\u064a \u0625\u0644\u0649 \u0627\u062e\u062a\u0644\u0627\u0641\u060c \u0648\u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u064a\u0644 \u0623\u0646 \u064a\u062f\u0641\u0639 \u062b\u0645\u0646 \u0647\u0630\u0627 \u0627\u0644\u0627\u062e\u062a\u0644\u0627\u0641. <br>\n\u0623\u064a \u0639\u0645\u0644 \u063a\u064a\u0631 \u0645\u0630\u0643\u0648\u0631 \u0641\u064a \u0641\u0627\u062a\u0648\u0631\u0629 \u0627\u0644\u0643\u0645\u064a\u0627\u062a \u0633\u064a\u062a\u0645 \u0641\u0631\u0636 \u0631\u0633\u0648\u0645 \u0625\u0636\u0627\u0641\u064a\u0629 \u0639\u0644\u064a\u0647\u060c \u0648\u0633\u064a\u062a\u062d\u0645\u0644 \u0627\u0644\u0639\u0645\u064a\u0644 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0648\u0645.<br>\n\u0623\u064a \u0639\u0645\u0644 \u0625\u0636\u0627\u0641\u064a \u0633\u064a\u0624\u062f\u064a \u0625\u0644\u0649 \u0648\u0642\u062a \u0625\u0636\u0627\u0641\u064a \u064a\u0633\u062a\u063a\u0631\u0642\u0647 \u0625\u0643\u0645\u0627\u0644 \u0627\u0644\u0645\u0634\u0631\u0648\u0639.<br>\n\u0633\u064a\u062a\u0645 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0639\u0645\u0644 \u0648\u0641\u0642\u0627\u064b \u0644\u0627\u062d\u062a\u064a\u0627\u062c\u0627\u062a \u0627\u0644\u0639\u0645\u064a\u0644 \u0648\u062a\u0648\u0627\u0641\u0631 \u0627\u0644\u0645\u0648\u0627\u062f.<br>\n</div>\n\n\n<div style=\"font-size:16px;margin-top:8px;\">\n<b>\n\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u0641\u0639\n\n</b>\n</div>\n{% if doc.payment_schedule %}\n   <table class=\"payment-table\" dir=\"rtl\">\n            <tbody>\n                {% for payment in doc.payment_schedule %}\n                <tr>\n                    <td width=\"10%\" style=\"background-color:#fba8b8;\"> {{payment.idx or \"\"}}</td>\n                    <td width=\"55%\"> {{payment.payment_term or \"\"}}</td>\n                    <td width=\"15%\"> {{payment.invoice_portion or \"\"}} %</td>\n               \n                    \n                    <td width=\"20%\"> {{\"{:,.2f}\".format(payment.payment_amount) or \"\"}}</td>\n                    \n                </tr>\n                 \n                {% endfor %}\n            </tbody>\n        </table>\n        \n       {% endif %}\n\n<div style=\"margin-top:8px;\">\n\n\u062a\u062d\u064a\u0627\u062a\u064a \u0627\u0644\u0637\u064a\u0628\u0629\u060c<br>\n\u0645\u062d\u0645\u062f \u0627\u0628\u0631\u0627\u0647\u064a\u0645<br>\n\u0627\u0644\u0645\u062f\u064a\u0631 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a<br>\n\n</div>\n\n\n</div>\n        \n",
