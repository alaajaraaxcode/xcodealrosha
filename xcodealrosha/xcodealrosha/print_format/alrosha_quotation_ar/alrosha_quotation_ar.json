 "css": "@page {\n  margin-top:100px;\n  margin-bottom:100px\n}\n.header-table th{\n      padding: 2px !important;\n}\n.header-table td{\n      padding: 2px !important;\n}\n.item-table{\n    \n    text-align:center;\n}\n.item-table th {\n   background-color:black;\n   color:white;\n       padding: 6px !important;\n    text-align:center;\n    border:1px solid black;\n}\n\n.item-table td {\n    padding: 6px !important;\n    text-align:center;\n    color:black;\n     border:1px solid black;\n}\n\n.payment-table {\n    width:100%;\n}\n.payment-table th, .payment-table td{\n    padding: 6px !important;\n    text-align:center;\n    border:1px solid black;\n}",
