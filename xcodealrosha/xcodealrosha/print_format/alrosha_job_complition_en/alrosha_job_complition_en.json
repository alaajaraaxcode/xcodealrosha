 "html": "<div class=\"height\">\n    \n        <div style=\"display: flex;\n    flex-direction: row;\n    align-items: center;\n    justify-content: space-between;\n        \"> \n        \n        <div style=\"width:41%\"> \n           <h4 style=\"text-align: start; \">Al Rosha General Maintenance & Cleaning Est. </h4>\n        </div>\n          \n        <div style=\"width:32%\"> \n                <img src=\"/assets/xcodealrosha/images/a884eac1-8331-4172-b292-0a5391c72c67.jpeg\" >\n        </div>\n        <div style=\"width:27%\"> \n            <h4 style=\" text-align: end;  \">\n                \n                \u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0631\u0648\u0634\u0629 \u0644\u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u062a\u0646\u0638\u064a\u0641\u0627\u062a\n            </h4>\n        </div>\n            \n        </div>\n  \n    \n   </div>\n        <div style=\"margin-top: 20px; text-align:center;font-size:18px;font-weight:700; border:2px solid black;\">\n          Job Completion Report\n        </div>\n        \n        \n         <table class=\"item-table\" style=\"margin-top:20px \">\n                <!--<thead>-->\n\n                <!--</thead>-->\n                <tbody>\n                <tr>\n                        <td   width=\"25%\" >SITE NAME:</td>\n                        <td   >{{doc.site_name or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td   width=\"25%\" >LOCATION:</td>\n                        <td   >{{doc.location or \"\"}}</td>\n    \n                </tr>\n\n                <tr>\n                        <td   width=\"25%\" >UNIT DETAILS:</td>\n                        <td   >{{doc.unit_details or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td   width=\"25%\" >DATE:</td>\n                        <td   >{{doc.date or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td   width=\"25%\" >TYPE OF WORK:</td>\n                        <td   >{{doc.type_of_work or \"\"}}</td>\n    \n                </tr>\n                \n\n\n\n                {% if doc.po %}\n                <tr>\n                    <td   width=\"25%\" >PO #:</td>\n                    <td   >{{doc.po or \"\"}}</td>\n\n                </tr>\n                 {% endif %}\n                {% if  doc.si %}\n                <tr>\n                    <td   width=\"25%\" >Sales Invoice #:</td>\n                    <td   >{{doc.si or \"\"}}</td>\n\n                </tr>\n                {% endif %}\n                {% if  doc.qu %}\n                <tr>\n                    <td   width=\"25%\" >Quotation #:</td>\n                    <td   >{{doc.qu or \"\"}}</td>\n\n                </tr>\n\n                {% endif %}\n\n                <tr>\n                        <td   width=\"25%\" >NUMBER OF PAGES:</td>\n                        <td   >{{doc.number_of_pages or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td class=\"colored\" width=\"100%\" colspan=\"2\">DESCRIPTION OF WORK:</td>\n                      \n    \n                </tr>\n                <tr>\n                        <td class=\"\" style=\"text-align:center ;\" width=\"100%\" colspan=\"2\">{{doc.descreption_of_work or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td class=\"colored\" width=\"100%\" colspan=\"2\" >ACTION TAKEN:</td>\n    \n                </tr>\n                <tr>\n\n                        <td class=\"\" style=\"text-align:start ;\" width=\"100%\" colspan=\"2\" >{{doc.action_taken or \"\"}}</td>\n    \n                </tr>\n                <tr>\n                        <td class=\"colored\" style=\"text-align:center ;\" width=\"100%\" colspan=\"2\">   PICTURES</td>\n    \n                </tr>\n                <tr>\n                        <td class=\"colored\" style=\"text-align:center ;\" width=\"100%\" colspan=\"2\"> BEFORE</td>\n    \n                </tr>\n                \n\n                 \n             {% set image_count = doc.before|length %}\n            {% for i in range(0, image_count, 2) %}\n                <tr>\n                    <td width=\"50%\" style=\"padding: 0 !important\">\n                        {% if doc.before[i] %}\n                            <img src=\"{{ doc.before[i].image }}\" alt=\"Before Picture {{ i + 1 }}\">\n                        {% endif %}\n                    </td>\n                    <td width=\"50%\" style=\"padding: 0 !important\">\n                {% if i + 1 < image_count and doc.before[i + 1] %}\n                    <img src=\"{{ doc.before[i + 1].image }}\" alt=\"Before Picture {{ i + 2 }}\">\n                {% endif %}\n                    </td>\n                </tr>\n            {% endfor %}                \n                <tr>\n                        <td class=\"colored\" style=\"text-align:center ;\" width=\"100%\" colspan=\"2\"> AFTER</td>\n    \n                </tr>\n                <tr>\n             {% set image_count = doc.after|length %}\n            {% for i in range(0, image_count, 2) %}\n                <tr>\n                    <td width=\"50%\" style=\"padding: 0 !important\">\n                        {% if doc.after[i] %}\n                            <img src=\"{{ doc.after[i].image }}\" alt=\"after Picture {{ i + 1 }}\">\n                        {% endif %}\n                    </td>\n                    <td width=\"50%\" style=\"padding: 0 !important\">\n                {% if i + 1 < image_count and doc.after[i + 1] %}\n                    <img src=\"{{ doc.after[i + 1].image }}\" alt=\"after Picture {{ i + 2 }}\">\n                {% endif %}\n                    </td>\n                </tr>\n            {% endfor %}   \n    \n                </tr>\n         </tbody>\n            </table> \n\n            <div style=\"border-bottom:1px solid black; padding-bottom:6px;\">In case of any further information or clarification, please feel free to contact us.</div>\n   \n            <div style=\"text-align:center;\">AL ROSHA GENERAL MAINTENANCE & CLEANING EST., TEL +971 2 6410062</div>\n            \n            \n             <div style=\" margin-top:32px;\"></div>\n             <div style=\"display:flex;flex-direction:row; align-items:end;justify-content: end;\">\n                 \n                  <div style=\"\"> Al Rosha Sign & Stamp</div>\n\n             </div>\n        </div>\n",
