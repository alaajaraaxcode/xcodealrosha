              \n                                 {% set image_count_before = doc.before|length %}\n                                 {% set image_count = doc.after|length %}\n                                 {% set row_count_before = (image_count_before / 2)|round(method='ceil') %}\n                                 \n                                  {% set row_count_after = (image_count / 2)|round(method='ceil') %}\n                                   {% set row_count = row_count_after + row_count_before %}\n                          \n                                  {% set total_rows = 0 %}\n                                  {% set ns = namespace(total_rows=0) %}\n                                {% for i in range(0, image_count_before, 2) %}\n                                \n                                 {% set ns.total_rows = ns.total_rows + 1 %}\n                                    <tr {% if ns.total_rows % 3 == 0 %}\n                                        style=\"page-break-after: always;\"\n                                        {% endif %}>\n                                        <td width=\"50%\" style=\"padding: 0 !important\">\n                                            {% if doc.before[i] %}\n                                                <img src=\"{{ doc.before[i].image }}\" alt=\"Before Picture {{ i + 1 }}\">\n                                            {% endif %}\n                                        </td>\n                                        <td width=\"50%\" style=\"padding: 0 !important\">\n                                    {% if i + 1 < image_count_before and doc.before[i + 1] %}\n                                        <img src=\"{{ doc.before[i + 1].image }}\" alt=\"Before Picture {{ i + 2 }}\">\n                                    {% endif %}\n                                        </td>\n                                    </tr>\n\n                                {% endfor %}                \n                                    <tr>\n                                            <td class=\"colored\" style=\"text-align:center ;\" width=\"100%\" colspan=\"2\"> \u0628\u0639\u062f</td>\n                        \n                                    </tr>\n\n\n\n                                    <tr>\n                                 \n                                {% for i in range(0, image_count, 2) %}\n                                    {% set ns.total_rows = ns.total_rows+1 %}\n                                    <tr     {% if ns.total_rows % 3 == 0 %}\n        style=\"page-break-after: always;\"\n    {% endif %}>\n                                        <td width=\"50%\" style=\"padding: 0 !important\">\n                                            {% if doc.after[i] %}\n                                                <img src=\"{{ doc.after[i].image }}\" alt=\"after Picture {{ i + 1 }}\">\n                                            {% endif %}\n                                        </td>\n                                        <td width=\"50%\" style=\"padding: 0 !important\">\n                                    {% if i + 1 < image_count and doc.after[i + 1] %}\n                                        <img src=\"{{ doc.after[i + 1].image }}\" alt=\"after Picture {{ i + 2 }}\">\n                                    {% endif %}\n                                        </td>\n                                    </tr>\n\n\n                                {% endfor %}   \n                        \n                                    </tr>\n                             </tbody>\n                             \n\n                                </table> \n                    \n                                <!--<div style=\"border-bottom:1px solid black; padding-bottom:6px;direction:rtl;\">-->\n                                <!--\u0641\u064a \u062d\u0627\u0644\u0629 \u0648\u062c\u0648\u062f \u0623\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0623\u0648 \u062a\u0648\u0636\u064a\