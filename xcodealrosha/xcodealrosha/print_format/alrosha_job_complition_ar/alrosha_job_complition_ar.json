to Serif';margin-top:0!important;\n                                              margin-bottom:0!important;\">Al Rosha General Maintenance & Cleaning Est. </h4>\n                                    </div>\n                                      \n                    \n                                    <div style=\"width:100%\"> \n                                        <h4 style=\" text-align: center;   font-family: 'Noto Kufi Arabic';margin-top:0!important;\n                                              margin-bottom:0!important;\">\n                                            \n                                            \u0645\u0624\u0633\u0633\u0629 \u0627\u0644\u0631\u0648\u0634\u0629 \u0644\u0644\u0635\u064a\u0627\u0646\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u062a\u0646\u0638\u064a\u0641\u0627\u062a\n                                        </h4>\n                                    </div>\n                                \n                            </div>\n                      \n                        \n                       </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </td>\n            </tr>\n        </thead>\n        <tbody>\n\n            <tr>\n                <td>\n\n\n                    <div class=\"\">\n\n                            <div style=\"margin-top: 20px; text-align:center;font-size:18px;font-weight:700; border:2px solid black;\">\n                              \u062a\u0642\u0631\u064a\u0631 \u0625\u0646\u062c\u0627\u0632 \u0627\u0644\u0639\u0645\u0644\n                            </div>\n                            \n                            \n                             <table dir=\"rtl\" class=\"item-table\" style=\"margin-top:20px \">\n                                    <!--<thead>-->\n                    \n                                    <!--</thead>-->\n                                    <tbody>\n                                    <tr>\n                                            <td   width=\"25%\" >\n                                            \u0627\u0633\u0645 \u0627\u0644\u0645\u0648\u0642\u0639:\n                                            </td>\n                                            <td   >{{doc.site_name or \"\"}}</td>\n                        \n                                    </tr>\n                                    <tr>\n                                            <td   width=\"25%\" >\u0627\u0644\u0645\u0648\u0642\u0639:</td>\n                                            <td   >{{doc.location or \"\"}}</td>\n                        \n                                    </tr>\n                    \n                                    <tr>\n                                            <td   width=\"25%\" >\n                                            \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0648\u062d\u062f\u0629:\n                                            </td>\n                                            <td   >{{doc.unit_details or \"\"}}</td>\n                        \n                                    </tr>\n                                    <tr>\n                                            <td   width=\"25%\" >\u0627\u0644\u0646\u0627\u0631\u064a\u062e:</td>\n                                            <td   >{{doc.date or \"\"}}</td>\n                        \n                                    </tr>\n                                    <tr>\n                                            <td   width=\"25%\" >\n                                            \u0646\u0648\u0639 \u0627\u0644\u0639\u0645\u0644:\n                                            </td>\n                                            <td   >{{doc.type_of_work or \"\"}}</td>\n                        \n                                    </tr>\n                                    \n                    \n                                    {% if  doc.qu %}\n                                    <tr>\n                                        <td   width=\"25%\" >\n                                            \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631 :\n                                        </td>\n                                        <td   >{{doc.qu or \"\"}}</td>\n                    \n                                    </tr>\n                    \n                                    {% endif %}                    \n                    \n                                    {% if doc.po %}\n                                    <tr>\n                                        <td   width=\"25%\" >\u0631\u0642\u0645 \u0637\u0644\u0628 \u0627\u0644\u0634\u0631\u0627\u0621 :</td>\n                                        <td   >{{doc.po or \"\"}}</td>\n                    \n                                    </tr>\n                                     {% endif %}\n                                    {% if  doc.si %}\n                                    <tr>\n                                        <td   width=\"25%\" >\n                                        \u0631\u0642\u0645 \u0637\u0644\u0628 \u0627\u0644\u0628\u064a\u0639:</td>\n                                        <td   >{{doc.si or \"\"}}</td>\n                    \n                                    </tr>\n                                    {% endif %}\n\n                    \n                                    <tr>\n                                            <td   width=\"25%\" >\n                                                \u0639\u062f\u062f \u0627\u0644\u0635\u0641\u062d\u0627\u062a:\n                                            </td>\n                                            <td   >{{doc.number_of_pages or \"\"}}</td>\n                        \n                                    </tr>\n                                    <tr>\n                                            <td class=\"colored\" width=\"100%\" colspan=\"2\">\n         