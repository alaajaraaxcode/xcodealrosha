 "css": "/*@page {*/\n/*  margin-top:100px;*/\n/*  margin-bottom:100px*/\n/*}*/\n\n*{\n    color: black;\n  \n}\ntable{width: 100%;}\n.red > div{\n    padding:4px;\n}\n.item-table{\n    text-align:start;\n}\n.item-table th{\n    background-color:#e23b32;\n    color:white;\n    text-align:center;\n    border: 1px solid black;\n}\n\n.colored{    background-color: #dad8d9;\n    color:black;\n    text-align:start;}\n.item-table td{\n    border: 1px solid black;\n}",
